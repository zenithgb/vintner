{
  "multipart": [
    {
      "apply": {
        "model": "vintner:block/trellis/trellis_single"
      }
    },
    {
      "when": {
        "east": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level"
      }
    },
    {
      "when": {
        "south": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 90
      }
    },
    {
      "when": {
        "west": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 180
      }
    },
    {
      "when": {
        "north": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 270
      }
    },
    {
      "when": {
        "age": "0"
      },
      "apply": {
        "model": "vintner:block/white_grapevine_age_0"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "vintner:block/white_grapevine_age_1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "vintner:block/white_grapevine_age_2"
      }
    },
    {
      "when": {
        "age": "3"
      },
      "apply": {
        "model": "vintner:block/white_grapevine_age_3"
      }
    }
  ]
}
