{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "vintner:block/pale_oak_aging_barrel"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "vintner:block/pale_oak_aging_barrel",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "vintner:block/pale_oak_aging_barrel",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "vintner:block/pale_oak_aging_barrel",
        "y": 270
      }
    },
    {
      "when": {
        "status": "1",
        "wine_type": "1"
      },
      "apply": {
        "model": "vintner:block/aging_barrel_red_aging"
      }
    },
    {
      "when": {
        "status": "1",
        "wine_type": "2"
      },
      "apply": {
        "model": "vintner:block/aging_barrel_white_aging"
      }
    },
    {
      "when": {
        "status": "2",
        "wine_type": "1"
      },
      "apply": {
        "model": "vintner:block/aging_barrel_red_ready"
      }
    },
    {
      "when": {
        "status": "2",
        "wine_type": "2"
      },
      "apply": {
        "model": "vintner:block/aging_barrel_white_ready"
      }
    }
  ]
}
