{
  "multipart": [
    {
      "apply": {
        "model": "vintner:block/trellis/jungle_trellis_single"
      }
    },
    {
      "when": {
        "east": "level",
        "upper": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level"
      }
    },
    {
      "when": {
        "south": "level",
        "upper": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 90
      }
    },
    {
      "when": {
        "west": "level",
        "upper": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 180
      }
    },
    {
      "when": {
        "north": "level",
        "upper": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 270
      }
    },
    {
      "when": {
        "age": "0",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/red_grapevine_age_0"
      }
    },
    {
      "when": {
        "age": "1|2|3",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/red_grapevine_age_1"
      }
    },
    {
      "when": {
        "age": "2",
        "upper": "true"
      },
      "apply": {
        "model": "vintner:block/red_grapevine_age_2"
      }
    },
    {
      "when": {
        "age": "3",
        "upper": "true"
      },
      "apply": [
        {
          "model": "vintner:block/red_grapevine_age_3"
        },
        {
          "model": "vintner:block/red_grapevine_age_3_b"
        },
        {
          "model": "vintner:block/red_grapevine_age_3_c"
        }
      ]
    },
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "none",
        "west": "level",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/jungle_end_brace"
      }
    },
    {
      "when": {
        "north": "level",
        "east": "none",
        "south": "none",
        "west": "none",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/jungle_end_brace",
        "y": 90
      }
    },
    {
      "when": {
        "north": "none",
        "east": "level",
        "south": "none",
        "west": "none",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/jungle_end_brace",
        "y": 180
      }
    },
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "level",
        "west": "none",
        "upper": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/jungle_end_brace",
        "y": 270
      }
    }
  ]
}
