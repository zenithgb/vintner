{
  "multipart": [
    {
      "apply": {
        "model": "vintner:block/trellis/trellis_single"
      }
    },
    {
      "when": {
        "east": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level"
      }
    },
    {
      "when": {
        "south": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 90
      }
    },
    {
      "when": {
        "west": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 180
      }
    },
    {
      "when": {
        "north": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level",
        "y": 270
      }
    },
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "none",
        "west": "level"
      },
      "apply": {
        "model": "vintner:block/trellis/end_brace"
      }
    },
    {
      "when": {
        "north": "level",
        "east": "none",
        "south": "none",
        "west": "none"
      },
      "apply": {
        "model": "vintner:block/trellis/end_brace",
        "y": 90
      }
    },
    {
      "when": {
        "north": "none",
        "east": "level",
        "south": "none",
        "west": "none"
      },
      "apply": {
        "model": "vintner:block/trellis/end_brace",
        "y": 180
      }
    },
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "level",
        "west": "none"
      },
      "apply": {
        "model": "vintner:block/trellis/end_brace",
        "y": 270
      }
    }
  ]
}
