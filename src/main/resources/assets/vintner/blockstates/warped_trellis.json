        "has_below": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/warped_end_brace",
        "y": 180
      }
    },
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "level",
        "west": "none",
        "has_below": "false"
      },
      "apply": {
