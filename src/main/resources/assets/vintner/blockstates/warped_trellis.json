{
  "multipart": [
    {
      "apply": {
        "model": "vintner:block/trellis/warped_trellis_single"
      }
    },
    {
      "when": {
        "has_above": "false",
        "east": "level",
        "sloped": "false"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level"
      }
    },
    {
      "when": {
        "has_above": "false",
        "east": "level",
        "facing": "north|south",
        "sloped": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_level"
      }
    },
    {
      "when": {
        "has_above": "false",
        "east": "level",
        "facing": "east",
        "sloped": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_up"
      }
    },
    {
      "when": {
        "has_above": "false",
        "east": "level",
        "facing": "west",
        "sloped": "true"
      },
      "apply": {
        "model": "vintner:block/trellis/wire_down"
      }
    },
    {
      "when": {
        "has_above": "false",
