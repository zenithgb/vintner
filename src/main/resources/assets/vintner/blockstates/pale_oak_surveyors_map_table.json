{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "vintner:block/pale_oak_surveyors_map_table",
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "north",
        "has_maps": "true"
      },
      "apply": {
        "model": "vintner:block/surveyors_map_table_maps",
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "vintner:block/pale_oak_surveyors_map_table",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "has_maps": "true"
      },
      "apply": {
        "model": "vintner:block/surveyors_map_table_maps",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "vintner:block/pale_oak_surveyors_map_table",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "has_maps": "true"
      },
      "apply": {
        "model": "vintner:block/surveyors_map_table_maps",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "vintner:block/pale_oak_surveyors_map_table",
        "uvlock": true,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "has_maps": "true"
      },
      "apply": {
        "model": "vintner:block/surveyors_map_table_maps",
        "uvlock": true,
        "y": 270
      }
    }
  ]
}
