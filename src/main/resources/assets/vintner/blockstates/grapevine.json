{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "vintner:block/oak_trellis"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "vintner:block/oak_trellis",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "vintner:block/oak_trellis",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "vintner:block/oak_trellis",
        "y": 270
      }
    },
    {
      "when": {
        "age": "0"
      },
      "apply": {
        "model": "vintner:block/grapevine_age_0"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "vintner:block/grapevine_age_1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "vintner:block/grapevine_age_2"
      }
    },
    {
      "when": {
        "age": "3"
      },
      "apply": {
        "model": "vintner:block/grapevine_age_3"
      }
    }
  ]
}
